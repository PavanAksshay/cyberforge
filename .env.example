# Development-only credentials. Change before exposing services.
POSTGRES_USER=astraroll
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=astraroll
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://astraroll:local-dev-only@localhost:5432/astraroll
REDIS_URL=redis://localhost:6379/0
ORDER_STREAM=astraroll:orders:v1
RELAY_BATCH_SIZE=100
RELAY_POLL_SECONDS=0.5
