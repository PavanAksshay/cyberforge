# Development-only credentials. Change before exposing services.
POSTGRES_USER=astraroll
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=astraroll
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://astraroll:local-dev-only@localhost:5432/astraroll
REDIS_URL=redis://localhost:6379/0
ORDER_STREAM=astraroll:orders:v1
RELAY_BATCH_SIZE=100
RELAY_POLL_SECONDS=0.5
# Real reader fails closed until explicit bootstrap establishes durable coverage.
ANALYTICS_BACKEND=postgres
ANALYTICS_COVERAGE_PROVIDER=astraroll.aggregation.coverage:read_coverage
COVERAGE_MAX_AGE_SECONDS=86400
# Trusted records contain only digests, subjects, memberships, expiry and is_admin.
# Generate locally: python -m astraroll.analytics.issue_key --subject demo --tenant UUID
# Never commit issued bearer keys. Empty registry fails closed on all tenant routes.
ANALYTICS_API_KEYS_JSON=[]

# V2: use compose.yaml + compose.v2.yaml. Never use archival V1 as control DB.
DEPLOYMENT_MODE=database_per_tenant
CONTROL_DATABASE_URL=postgresql+psycopg://astraroll:local-dev-only@localhost:5432/astraroll
MAX_ACTIVE_TENANT_POOLS=10
TENANT_POOL_SIZE=1
TENANT_POOL_MAX_OVERFLOW=0
