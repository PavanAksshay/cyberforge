# Development-only credentials. Change before exposing services.
POSTGRES_USER=astraroll
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=astraroll
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://astraroll:local-dev-only@localhost:5432/astraroll
REDIS_URL=redis://localhost:6379/0
ORDER_STREAM=astraroll:orders:v1
RELAY_BATCH_SIZE=100
RELAY_POLL_SECONDS=0.5
# Optional A-owned analytics bridge. Default remains unavailable until shared contracts agree.
ANALYTICS_BACKEND=unavailable
# B must supply a trusted durable provider; a first tenant revision is not coverage.
# ANALYTICS_COVERAGE_PROVIDER=your_package.coverage:read_coverage
# JSON array of SHA-256 digest records, subjects, tenant UUIDs and UTC expiry timestamps.
# Generate locally: python -m astraroll.analytics.issue_key --subject demo --tenant UUID
# Keep issued bearer keys out of this file and git. Empty registry fails closed.
ANALYTICS_API_KEYS_JSON=[]
